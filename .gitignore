# ==========================================
# Outcognito Monorepo - Comprehensive .gitignore
# ==========================================

# 1. Environment & Sensitive Files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
credentials.json
secrets.json
.aws/
.gcp/

# 2. Local Container & Orchestration Files
docker-compose.yml
docker-compose*.yml
docker-compose*.yaml

# 3. Archives & Compressed Packages
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z
outcognito-api.zip

# 4. Dependencies
node_modules/
.pnpm-store/

# 5. Build & Output Directories
.next/
out/
build/
.vercel/
dist/
dist-ssr/
apps/extension/dist/

# 6. Logs & Debugging Output
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 7. Caches & Temporary Files
.cache/
.turbo/
.eslintcache
*.tsbuildinfo
.tmp/
temp/

# 8. OS Metadata
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# 9. IDEs & Editors
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo

# 10. Testing & Coverage
coverage/
.nyc_output/

# 11. Auto-generated Agent files
AGENTS.md
CLAUDE.md