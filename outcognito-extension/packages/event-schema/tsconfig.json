{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",

    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,

    "rootDir": "./src",
    "outDir": "./dist",

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "resolveJsonModule": true
  },

  "include": [
    "src/index.ts"
  ],

  "exclude": [
    "node_modules",
    "dist",
    "src/test-sample.ts"
  ]
}