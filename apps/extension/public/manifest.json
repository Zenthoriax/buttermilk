{
  "name": "Outcognito",
  "version": "0.1.0",
  "manifest_version": 3,
  "permissions": ["storage", "tabs", "windows", "alarms", "idle"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Outcognito Options"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}