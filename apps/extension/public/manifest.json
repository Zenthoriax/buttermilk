{
  "manifest_version": 3,
  "name": "Outcognito",
  "version": "0.1.0",
  "description": "Privacy-first behavioral tracking for Outcognito.",
  "permissions": ["tabs", "storage", "idle", "alarms"],
  "host_permissions": ["http://localhost/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html"
  }
}